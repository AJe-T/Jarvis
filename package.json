  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node scripts/vitest-electron.mjs run",
    "test:e2e": "playwright test",
    "evals": "node scripts/run-evals.mjs",
    "evals:compare": "node scripts/compare-evals.mjs",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "postinstall": "electron-builder install-app-deps",
    "secret-scan": "node scripts/secret-scan.mjs",
    "release-gate": "npm run typecheck && npm run lint && npm run test -- --coverage && npm audit --omit=dev --audit-level=high && npm run build && npm run test:e2e && npm run secret-scan",
    "laya:install": "node scripts/laya-install.mjs",
    "docs:reference": "node scripts/docs-reference.mjs",
    "check:contrast": "node scripts/check-glass-contrast.mjs"
  },
